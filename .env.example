# BingX Perpetual Futures VST (the only enabled execution environment)
BINGX_API_KEY=your_bingx_vst_api_key
BINGX_SECRET_KEY=your_bingx_vst_secret_key
BINGX_ENV=vst
BINGX_BASE_URL=https://open-api-vst.bingx.com
BINGX_MARGIN_MODE=isolated
BINGX_POSITION_MODE=hedge
BINGX_RECV_WINDOW_MS=5000
BINGX_SOURCE_KEY=BX-AI-SKILL
BINGX_ROUTE_MIN_INTERVAL_SECONDS=0.2
BINGX_MARKET_CACHE_SECONDS=1
BINGX_INSECURE_SSL=false
BINGX_DEBUG_HTTP=false

# Symbols use internal BASE/QUOTE format; the BingX client maps them to BASE-QUOTE.
SYMBOLS=BTC/USDT,ETH/USDT
DECISION_TIMEFRAMES=1m,3m,5m

# OpenAI-compatible AI brain (required when STRATEGY_MODE=grok or ai_volume)
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://api.freemodel.dev/v1
XAI_MODEL=gpt-5.4
XAI_API_STYLE=chat
XAI_REASONING_EFFORT=high
XAI_TIMEOUT_SECONDS=90
XAI_MAX_TOKENS=1600

# External live/near-live signal providers
COINMARKETCAP_API_KEY=
DUNE_API_KEY=
DUNE_QUERY_IDS=
DUNE_USE_BUILTIN_SIGNALS=true
DUNE_PERFORMANCE_TIER=medium
DUNE_EXECUTION_POLL_SECONDS=2
DUNE_EXECUTION_TIMEOUT_SECONDS=45
TRADINGVIEW_SIGNAL_URL=http://127.0.0.1:8787/tradingview/latest
TRADINGVIEW_SIGNAL_TOKEN=change-this-local-relay-token
TRADINGVIEW_WEBHOOK_URL=http://127.0.0.1:8787/tradingview/webhook?token=change-this-local-relay-token

# Required Supabase primary store for executed trades and AI decisions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TRADES_TABLE=trades
SUPABASE_AI_DECISIONS_TABLE=ai_decisions
SUPABASE_AI_EXIT_VERDICTS_TABLE=ai_exit_verdicts
SUPABASE_AI_CALL_METRICS_TABLE=ai_call_metrics
SUPABASE_OPEN_POSITIONS_TABLE=open_position_state

# Bot behavior
STRATEGY_MODE=ai_volume
TRADE_TARGET_PER_DAY=28
MAX_STOP_LOSS_PER_DAY=2
POSITION_USDT=180
LEVERAGE=100
VOLUME_MARGIN_PER_ENTRY_USDT=180
VOLUME_SIDES_PER_ENTRY=2
VOLUME_EXECUTION_MODE=market
VOLUME_ATTEMPT_TARGET_PER_DAY=34
VOLUME_MIN_FILLED_ENTRIES_PER_DAY=28
# Planning figure for the volume profile and arena reports. It does NOT stop the bot (only the daily target and fee budget pause entries).
VOLUME_TARGET_USDT=30000000
VOLUME_DAILY_TARGET_USDT=1000000
# Optional timezone-aware ISO-8601 cutoff for a fresh venue volume cycle.
VOLUME_CYCLE_STARTED_AT=
VOLUME_NEUTRAL_EXIT_ENABLED=false
VOLUME_NEUTRAL_EXIT_MIN_SECONDS=5
VOLUME_NEUTRAL_EXIT_MIN_NET_USDT=0
VOLUME_NEUTRAL_EXIT_BAND_USDT=5
VOLUME_NEUTRAL_EXIT_MODE=window
VOLUME_NEUTRAL_EXIT_TRAIL_USDT=0
VOLUME_NEUTRAL_EXIT_BASIS=net
POSITION_STATUS_LOG_SECONDS=60
EXIT_REJECTION_RETRY_SECONDS=15
VOLUME_BREAKEVEN_EXIT_ENABLED=false
VOLUME_BREAKEVEN_MIN_SECONDS=5
VOLUME_BREAKEVEN_MAX_LOSS_USDT=1
VOLUME_BREAKEVEN_MIN_PROFIT_USDT=0
VOLUME_STOP_AT_TARGET_ENABLED=true
VOLUME_DAILY_FEE_BUDGET_USDT=600
TRADING_TIMEZONE=Asia/Jakarta

# Risk and timing
ENTRY_INTERVAL_MINUTES=3
POSITION_HOLD_MINUTES=60
MARKET_POLL_SECONDS=5
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.12
# Hard ceiling on the ATR-scaled stop (percent). 0 disables the cap.
MAX_STOP_LOSS_PCT=0
ENTRY_STRETCH_GATE_MODE=off
# any | long | short - restrict the entry gate to one side (only applies when the gate mode is not off)
ENTRY_GATE_DIRECTION=any
# Weekly window for NEW entries in TRADING_TIMEZONE, e.g. mon 07:00-sat 00:00 (Fri 24:00). Empty = always open.
ENTRY_WEEKLY_WINDOW=
ENTRY_STRETCH_GATE_MAX_ATR=0.75
ENTRY_STRETCH_GATE_BEHIND_SCHEDULE_ENTRIES_PER_HOUR=0.0
TAKER_FEE_PCT=0.05
MAKER_FEE_PCT=0.02
USE_EXCHANGE_FEE_RATES=true
EXECUTION_GUARDS_ENABLED=true
EXECUTION_ENTRY_ORDER_TYPE=market
EXECUTION_POST_ONLY_TIMEOUT_SECONDS=3
EXECUTION_POST_ONLY_MAX_REPRICES=5
EXECUTION_POST_ONLY_FALLBACK_TO_MARKET=false
MAKER_ENTRY_TTL_SECONDS=3
MAKER_EXIT_TTL_SECONDS=3
MAKER_MAX_REPRICES=5
MAKER_ALLOW_TAKER_EMERGENCY_EXIT=true
ORDERBOOK_DEPTH_LEVELS=20
MIN_ORDERBOOK_DEPTH_MULTIPLIER=1.2
MAX_ABS_FUNDING_RATE=0.001
MAX_SPREAD_BPS=6
FUNDING_BLACKOUT_MINUTES=10
HARD_MAX_LEVERAGE=100
VENUE_MAX_LEVERAGE=100
ACCOUNT_BALANCE_USDT=1500
MAX_RISK_PCT_PER_TRADE=0.5
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
COOLDOWN_MINUTES_AFTER_ENTRY=10
COOLDOWN_MINUTES_AFTER_STOP=20
# Regime gate, entry payload and setup ledger. naik is the LONG forward bot's gate (a separate instance, see
# docs/runbooks/long-forward-test.md; build_forward_env.py writes its values); map, lean and the ledger are the
# live bot's staged rollout (CLAUDE.md "Live staged fixes"). Every key below is off by default, so an unchanged
# .env keeps today's behaviour.
# ENTRY_REGIME_GATE: off | naik | map. naik lets an entry through only while the hourly mode selector reads NAIK.
# With naik, Settings refuses to boot unless ENTRY_GATE_DIRECTION=long, ENTRY_STRETCH_GATE_MODE=enforce and
# STRATEGY_MODE is grok or ai_volume (the side filter only runs in an AI strategy with the stretch gate enforcing).
# map lets the hour pick the side (NAIK long, TURUN short, SIDEWAYS and TIDAK_ENTRY none); it needs the same
# enforcing stretch gate and AI strategy, and accepts any ENTRY_GATE_DIRECTION. map (and the ledger on) also
# need VOLUME_NEUTRAL_EXIT_ENABLED=true, VOLUME_NEUTRAL_EXIT_MODE=floor, VOLUME_NEUTRAL_EXIT_BASIS=net and
# STRATEGY_MODE=ai_volume: shadow rows are walked with that exit, its floor sized from the ai_volume margin.
# ENTRY_REGIME_GATE=off
# Entry payload sent to the model: legacy (the full context, unchanged) | lean (compact per-setup features).
# lean states the stretch rule as enforced, so Settings refuses it unless ENTRY_STRETCH_GATE_MODE=enforce,
# a finite ENTRY_STRETCH_GATE_MAX_ATR > 0 and ENTRY_STRETCH_GATE_BEHIND_SCHEDULE_ENTRIES_PER_HOUR=0.
# AI_ENTRY_PAYLOAD=legacy
# Lean objective, read only with lean: edge (hold unless the setup beats the round-trip fee) | volume (trade the
# side the hourly regime offers on a pullback into the mean, hold only for a reason the model can name). volume
# needs AI_ENTRY_PAYLOAD=lean and ENTRY_REGIME_GATE=naik or map; pace entries with VOLUME_ATTEMPT_TARGET_PER_DAY
# (TRADE_TARGET_PER_DAY when VOLUME_DAILY_TARGET_USDT=0).
# AI_LEAN_OBJECTIVE=edge
# Setup ledger: off | shadow (record each OPEN decision's bucket verdict at payload_json.gate.ledger; no shadow
# rows, no veto) | enforce (also veto a setup whose upper bound stays below the hurdle and write a ledger_block
# shadow row for it). shadow and enforce need ENTRY_REGIME_GATE=naik or map, SETUP_LEDGER_SINCE and the floor
# neutral exit (see map above).
# SETUP_LEDGER_MODE=off
# First row the ledger may count: a timezone-aware ISO-8601 time, e.g. 2026-10-22T00:00:00+07:00. Empty = unset.
# SETUP_LEDGER_SINCE=
# Samples a setup needs before the ledger judges it (at least 2); fewer stays "learning".
# SETUP_LEDGER_MIN_SAMPLES=60
# Hurdle in gross bps per trade, before fees (4.0 = the -150 per 1M bar at 0.035 % per leg): a setup is vetoed when its mean + 1.28 x SE falls below this. Finite only.
# SETUP_LEDGER_HURDLE_BPS=4.0
# Skip entries while ATR14 (1h) > this multiple of its 720-hour median (and while the median is unknown). 0 = off.
# Read only when ENTRY_REGIME_GATE is not off.
# ENTRY_VOLATILITY_GUARD_MULT=0
# The selector's sideways band in ATR (config/modes.yaml pemilih_mode.sideways_jarak_kali_atr).
# REGIME_SIDEWAYS_ATR_MULT=0.2
# Pause after a close of any reason, in minutes. 0 = off.
# COOLDOWN_MINUTES_AFTER_EXIT=0
# Forward self-stop, from the closed trades since VOLUME_CYCLE_STARTED_AT in the configured Supabase schema:
# from KILL_AFTER positions on, entries latch off while the pooled result is below KILL_BELOW per 1M;
# REVIEW_AT latches them whatever the result. 0 = off.
# FORWARD_KILL_AFTER_POSITIONS=0
# FORWARD_KILL_BELOW_PER_1M=-500
# FORWARD_REVIEW_AT_POSITIONS=0
MAX_DAILY_DRAWDOWN_USDT=100
MAX_CONSECUTIVE_LOSSES=3
PREVENT_NEW_ENTRIES_IF_EXCHANGE_POSITION_OPEN=true

# Market intelligence
AI_KLINE_INTERVAL=3m
AI_KLINE_LIMIT=80
AI_RECENT_PERFORMANCE_LIMIT=20
AI_TRADE_MEMORY_LIMIT=40
AI_MIN_CONFIDENCE=0.75
AI_MIN_FEE_ADJUSTED_RR=2.0
# Loss (USDT) beyond which an AI close_now is honoured on a losing position.
# 0 keeps the legacy behaviour where only a profitable trade may be AI-closed.
AI_EXIT_ADVERSE_CUT_USDT=0
AI_SYSTEMIC_RISK_NO_TRADE_THRESHOLD=4
EXTERNAL_SIGNAL_CACHE_SECONDS=300

# Event-driven AI exit policy (deterministic SL/TP/time checks still run every 5s)
AI_EXIT_CHECK_INTERVAL_SECONDS=30
AI_EXIT_PRICE_MOVE_THRESHOLD_PCT=0.08
AI_EXIT_MAX_CALLS_PER_TRADE=12
AI_EXIT_EVENT_RESERVE_CALLS=0
AI_EXIT_MIN_HOLD_SECONDS=0
AI_EXIT_FAVORABLE_MOVE_THRESHOLD_PCT=0

# Compact AI payload shaping
AI_COMPACT_MAX_FACTORS_PER_SYMBOL=6
AI_COMPACT_MAX_FLOW_SIGNALS=5
AI_COMPACT_MAX_MEMORY_LESSONS=3

# Optional provider pricing so AI usage telemetry can report an estimated cost
AI_INPUT_COST_PER_MILLION_TOKENS=
AI_OUTPUT_COST_PER_MILLION_TOKENS=

# Selective confluence entry
CONFLUENCE_ENABLED=true
CONFLUENCE_MIN_AGREEMENT=0.55
CONFLUENCE_MIN_ATR_PCT=0.05
CONFLUENCE_MIN_SCORE=0.05
CONFLUENCE_ATR_TP_MULT=3.0
CONFLUENCE_ATR_SL_MULT=1.0

# Backend-only arena features inspired by Hyper-Alpha-Arena
ARENA_FACTORS_ENABLED=true
ARENA_FLOW_SIGNALS_ENABLED=true
ARENA_VOLUME_SPIKE_PCT=65
ARENA_VOLUME_COLLAPSE_PCT=-70
ARENA_PRICE_MOMENTUM_BPS=55
ARENA_OPEN_INTEREST_SURGE_PCT=7.5
ARENA_FUNDING_EXTREME_ABS=0.001
ARENA_FACTOR_SCORE_TRIGGER=0.75
ARENA_FACTOR_PERCENTILE_TRIGGER=0.90
ARENA_ORDER_FLOW_IMBALANCE_PCT=25
ARENA_MIN_DEPTH_NOTIONAL=25000
ARENA_PROGRAM_TRADER_ENABLED=false
ARENA_ATTRIBUTION_LOOKBACK_TRADES=100
ARENA_DIAGNOSIS_ENABLED=true

# Live dashboard feed (read-only, off by default). The listener refuses any host that
# is not loopback; from a laptop use `ssh -L 3000:localhost:<TELEMETRY_PORT> <vps>` and open the
# dashboard locally. Pick a TELEMETRY_PORT that no other process on the host holds.
# TELEMETRY_ALLOWED_ORIGIN is the one dashboard origin allowed by CORS.
TELEMETRY_ENABLED=false
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=3000
TELEMETRY_ALLOWED_ORIGIN=http://localhost:3001
TELEMETRY_PRICE_INTERVAL_SECONDS=5
# Live prices from BingX's public VST websocket (about 0.4s) instead of one poll every
# TELEMETRY_PRICE_INTERVAL_SECONDS. Polling stays on as the fallback. Read-only, no keys; the
# host is fixed to the VST one. Takes effect after a restart (flat position only).
TELEMETRY_PRICE_STREAM=false
# Extra symbols the dashboard shows (price and candles only), e.g. BTC/USDT,ETH/USDT; never traded.
# Empty = same as SYMBOLS, and SYMBOLS are always shown. Takes effect after a restart (flat only).
TELEMETRY_SYMBOLS=

# Runtime
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
ORDER_FILL_WAIT_SECONDS=3
