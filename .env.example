# OKX demo trading
OKX_API_KEY=your_okx_demo_api_key
OKX_SECRET_KEY=your_okx_demo_secret_key
OKX_PASSPHRASE=your_okx_demo_api_passphrase
OKX_BASE_URL=https://www.okx.com
OKX_DEMO_TRADING=true
OKX_MARGIN_MODE=isolated
OKX_POSITION_MODE=long_short_mode
OKX_INSTRUMENT_TYPE=SWAP
OKX_INSECURE_SSL=false
OKX_DEBUG_HTTP=false
OKX_REQUIRE_SET_LEVERAGE=false

# Symbols use internal BASE/QUOTE format; OKX client maps them to BASE-QUOTE-SWAP.
SYMBOLS=BTC/USDT,ETH/USDT
DECISION_TIMEFRAMES=1m,3m,5m

# xAI Grok brain (required when STRATEGY_MODE=grok or ai_volume)
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
XAI_REASONING_EFFORT=high
XAI_TIMEOUT_SECONDS=90

# External live/near-live signal providers
COINMARKETCAP_API_KEY=
DUNE_API_KEY=
DUNE_QUERY_IDS=
DUNE_USE_BUILTIN_SIGNALS=true
DUNE_PERFORMANCE_TIER=medium
DUNE_EXECUTION_POLL_SECONDS=2
DUNE_EXECUTION_TIMEOUT_SECONDS=45
TRADINGVIEW_SIGNAL_URL=http://127.0.0.1:8787/tradingview/latest
TRADINGVIEW_SIGNAL_TOKEN=change-this-local-relay-token
TRADINGVIEW_WEBHOOK_URL=http://127.0.0.1:8787/tradingview/webhook?token=change-this-local-relay-token

# Optional Supabase mirror for executed trades and AI decisions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TRADES_TABLE=trades
SUPABASE_AI_DECISIONS_TABLE=ai_decisions

# Bot behavior
STRATEGY_MODE=ai_volume
TRADE_TARGET_PER_DAY=16
MAX_STOP_LOSS_PER_DAY=2
POSITION_USDT=180
LEVERAGE=100
MIN_ORDER_CONTRACTS=1
VOLUME_MARGIN_PER_ENTRY_USDT=180
VOLUME_SIDES_PER_ENTRY=2
VOLUME_TARGET_USDT=10000000
VOLUME_NEUTRAL_EXIT_ENABLED=true
VOLUME_NEUTRAL_EXIT_MIN_SECONDS=5
VOLUME_NEUTRAL_EXIT_MIN_NET_USDT=12
VOLUME_NEUTRAL_EXIT_BAND_USDT=5

# Risk and timing
ENTRY_INTERVAL_MINUTES=15
POSITION_HOLD_MINUTES=20
MARKET_POLL_SECONDS=5
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.12
TAKER_FEE_PCT=0.05
USE_EXCHANGE_FEE_RATES=true
EXECUTION_GUARDS_ENABLED=true
EXECUTION_ENTRY_ORDER_TYPE=market
EXECUTION_POST_ONLY_TIMEOUT_SECONDS=8
EXECUTION_POST_ONLY_MAX_REPRICES=1
EXECUTION_POST_ONLY_FALLBACK_TO_MARKET=false
ORDERBOOK_DEPTH_LEVELS=20
MIN_ORDERBOOK_DEPTH_MULTIPLIER=1.2
MAX_ABS_FUNDING_RATE=0.001
ACCOUNT_BALANCE_USDT=1500
MAX_RISK_PCT_PER_TRADE=0.5
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
COOLDOWN_MINUTES_AFTER_ENTRY=10
COOLDOWN_MINUTES_AFTER_STOP=20
MAX_DAILY_DRAWDOWN_USDT=100
MAX_CONSECUTIVE_LOSSES=3
PREVENT_NEW_ENTRIES_IF_EXCHANGE_POSITION_OPEN=true

# Exchange-agnostic perpetual futures layer
# Keep PERP_EXCHANGE_API_NAME empty until the venue adapter/API contract is selected.
PERP_EXCHANGE_API_NAME=
PERP_DAILY_FEE_BUDGET_PCT=0.03
PERP_RISK_PER_TRADE_PCT=0.0075
PERP_FEE_ROUND_TRIP=0.005
PERP_SLIPPAGE_ROUND_TRIP=0.0004
PERP_EDGE_BUFFER_BPS=5
PERP_SIZING_MODE=volume
PERP_TARGET_MARGIN_PER_ENTRY_USDT=180
PERP_LEVERAGE_CAP=100
PERP_HARD_MAX_LEVERAGE=100
PERP_VENUE_MAX_LEVERAGE=100
PERP_MAINTENANCE_MARGIN_FALLBACK=0.005
PERP_MIN_LIQUIDATION_DISTANCE_BPS=10
PERP_MAX_SPREAD_BPS=6
PERP_FUNDING_BLACKOUT_MINUTES=10
PERP_MAX_DAILY_REALIZED_DRAWDOWN_PCT=0.03
PERP_MAX_ROLLING_DRAWDOWN_PCT=0.05

# Market intelligence
AI_KLINE_INTERVAL=1m
AI_KLINE_LIMIT=120
AI_MIN_CONFIDENCE=0.75
AI_MIN_FEE_ADJUSTED_RR=2.0
AI_SYSTEMIC_RISK_NO_TRADE_THRESHOLD=4
AI_PRE_TRADE_CHECK=true
EXTERNAL_SIGNAL_CACHE_SECONDS=300

# Runtime
REQUEST_TIMEOUT_SECONDS=20
DB_PATH=bot_data/trades.db
LOG_LEVEL=INFO
ORDER_FILL_WAIT_SECONDS=3
